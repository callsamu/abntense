{
  "type": "module",
  "name": "@monorepo/ui",
  "version": "0.0.0",
  "scripts": {
    "build": "rimraf dist && vue-tsc  && vite build"
  },
  "peerDependencies": {
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.3.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "rimraf": "^5.0.1",
    "typescript": "^5.1.6",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6"
  },
  "files": [
    "src",
    "dist"
  ],
  "main": "./dist/my-lib.es.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/main.es.js",
      "require": "./dist/main.cjs.js"
    },
    "./theme": {
      "types": "./dist/types/theme/index.d.ts",
      "import": "./dist/theme.es.js",
      "require": "./dist/theme.cjs.js"
    }
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "tailwindcss": "^4.1.12"
  }
}
