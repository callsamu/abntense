{
  "name": "@monorepo/ui",
  "version": "0.0.0",
  "scripts": {
    "build": "rimraf dist && vue-tsc -b && vite build",
    "cypress:open": "cypress open",
    "volt:add": "npx volt-vue add "
  },
  "peerDependencies": {
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.0",
    "@types/cypress": "^1.1.6",
    "@types/node": "^25.0.3",
    "@vitejs/plugin-vue": "^6.0.3",
    "cypress": "^15.8.1",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^3.2.1"
  },
  "files": [
    "src",
    "dist"
  ],
  "main": "./dist/my-lib.es.js",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.es.js",
      "require": "./dist/main.cjs.js"
    },
    "./theme": {
      "types": "./dist/main.d.ts",
      "import": "./dist/theme.es.js",
      "require": "./dist/theme.cjs.js"
    },
    "./styles/app.css": {
      "style": "./src/styles/app.css"
    }
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.1.18",
    "@types/mocha": "^10.0.10",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-primeui": "^0.6.1"
  }
}
