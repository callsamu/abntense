{
  "name": "@monorepo/ui",
  "version": "0.0.0",
  "scripts": {
    "build": "rimraf dist && vue-tsc -b && vite build",
    "cypress:open": "cypress open",
    "volt:add": "npx volt-vue add "
  },
  "peerDependencies": {
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@iconify/vue": "^4.3.0",
    "@types/cypress": "^0.1.6",
    "@types/node": "^20.3.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "cypress": "^15.0.0",
    "rimraf": "^5.0.1",
    "typescript": "^5.1.6",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^3.0.6"
  },
  "files": [
    "src",
    "dist"
  ],
  "main": "./dist/my-lib.es.js",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.es.js",
      "require": "./dist/main.cjs.js"
    },
    "./theme": {
      "types": "./dist/main.d.ts",
      "import": "./dist/theme.es.js",
      "require": "./dist/theme.cjs.js"
    },
    "./styles/app.css": {
      "style": "./src/styles/app.css"
    }
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/vite": "^4.1.12",
    "@types/mocha": "^10.0.10",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "tailwindcss-primeui": "^0.6.1"
  }
}
