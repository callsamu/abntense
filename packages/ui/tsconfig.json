{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "lib": ["es6", "dom"],
    "noEmit": true,
    "types": [
      "vite/client",
      "mocha"
    ],
    "paths": {
        "@/*": ["./src/*"]
    }
  },
  "include": [
      "src/**/*.ts",
      "src/**/*.d.ts",
      "src/**/*.tsx",
      "src/**/*.vue",
      "src/index.js",
      "cypress",
      "cypress.config.ts",
      "vite.config.mts"
  ]
}
